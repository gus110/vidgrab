{
  "manifest_version": 3,
  "name": "VidGrab — Instagram & TikTok Downloader",
  "version": "1.0.0",
  "description": "Send Instagram and TikTok videos to the VidGrab app with one click to download them to your PC.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.instagram.com/*", "*://*.tiktok.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:8743/*",
    "*://*.instagram.com/*",
    "*://*.tiktok.com/*"
  ]
}
